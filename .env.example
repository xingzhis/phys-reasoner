# Machine-local overrides — copy this file to .env and edit as needed.
# .env is gitignored; .env.example is tracked.
#
# env.sh (repo root) sources this file automatically. For interactive use:
#   source env.sh
#
# env.sh sets sensible defaults for everything below. Only uncomment lines
# where your setup differs from the defaults.

# HuggingFace model/dataset cache (default: $ROOT/hf_cache)
# HF_HOME=/path/to/your/hf_cache

# Container images (default: $ROOT/verl_vllm017.latest.sif / phys-reasoner-overlay-017.img)
# SIF=/path/to/custom.sif
# OVERLAY=/path/to/custom-overlay.img

# Slurm partition and QOS (cluster-specific)
# SBATCH_PARTITION=gpu
# SBATCH_QOS=qos_nmi
