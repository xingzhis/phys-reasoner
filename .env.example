# Machine-local overrides — copy this file to .env and edit as needed.
# .env is gitignored; .env.example is tracked.
# Sourced by sbatch scripts at startup (if .env exists in project root).
#
# ROOT and HF_HOME have sensible defaults and usually don't need to be set:
#   ROOT    — auto-derived from script location (repo root)
#   HF_HOME — defaults to ~/.cache/huggingface (standard HuggingFace default)

# Uncomment to override HF model/dataset cache location:
# HF_HOME=/path/to/your/hf_cache

# Uncomment if your cluster uses a different Slurm partition or QOS:
# SBATCH_PARTITION=gpu
# SBATCH_QOS=qos_nmi
