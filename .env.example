# Machine-local overrides — copy to .env and edit.
# env.sh sources this file automatically.
#
# Only uncomment and set what differs from the defaults.

# ── Paths ─────────────────────────────────────────────────────────────────────

# HuggingFace model/dataset cache (default: $ROOT/hf_cache)
# HF_HOME=/path/to/your/hf_cache

# Container images (default: $ROOT/verl_vllm017.latest.sif / phys-reasoner-overlay-017.img)
# SIF=/path/to/custom.sif
# OVERLAY=/path/to/custom-overlay.img

# ── SLURM ─────────────────────────────────────────────────────────────────────
# Standard SLURM env vars — sbatch uses these as defaults when the script has
# no matching #SBATCH directive. Must be exported (env.sh does this).

# GPU partition name (required)
# export SBATCH_PARTITION=gpu

# QOS — leave unset if your cluster doesn't use one
# export SBATCH_QOS=

# Account/allocation — leave unset if not required
# export SBATCH_ACCOUNT=

# ── Weights & Biases ──────────────────────────────────────────────────────────
# export WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
